GEMINI_API_KEY=
# optional overrides
LIVE_MODEL=gemini-3.8-live
VERIFY_MODEL=gemini-3.8-flash
PORT=8787
# whole model chains, comma separated (e.g. LIVE_MODELS=none to fail only Live and demo snapshot mode)
# LIVE_MODELS=
# VERIFY_MODELS=
# Optional shared access key for the public tunnel. When set, /api/* (except /api/health), /ingest/*,
# /live and /hud-ws need ?key=<k> or an x-holdup-key header (401 / WS close 4401). Static files stay public.
# HOLDUP_KEY=
# Optional ElevenLabs. Read from the environment only; never commit a value.
# Unset: /api/tts/eleven and /api/stt/token return 404, and speech falls back to the browser voice.
# ELEVENLABS_API_KEY=
# ELEVENLABS_LIVE=1
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_EN=
# ELEVENLABS_VOICE_FI=
# ELEVENLABS_VOICE_SV=
